<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão de vibração para feedback tátil opcional nas teclas. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Internet: verificação de atualizações no GitHub Releases e transcrição de voz pela API da Groq (esta só é usada se o usuário configurar a chave). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microfone para fala → texto (Groq Whisper). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Permissão para solicitar instalação de pacotes atualizados via instalador do sistema. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Aviso de nova versão disponível (Android 13 ou superior pede permissão). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Captura de tela mais recente, para a pílula da barra do teclado (só com a permissão concedida) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Remove o receiver transitivo da biblioteca androidx.profileinstaller e elimina a permissão DUMP -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- Atividade de Configuração e Teste do Teclado -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serviço de Entrada (IME) do Teclado -->
        <service
            android:name=".keyboard.LatinIMEKeyboardService"
            android:exported="true"
            android:label="@string/ime_service_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- FileProvider para instalação segura de APKs baixados -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Recebe o resultado da instalação feita pelo instalador do sistema -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

    </application>

</manifest>
